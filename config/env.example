# Finxxment — credential/placeholder checklist
#
# n8n does NOT read this file. n8n stores secrets in its own Credentials
# store, and each workflow's "Config" Set node holds non-secret IDs
# (spreadsheet id, folder id, etc). This file just documents every name
# used as a placeholder inside n8n/workflows/*.json and apps-script/*.gs
# so you have a single checklist while wiring up real credentials.
# See docs/02-setup-guide.md for the full step-by-step.

# --- n8n Credentials (create these under n8n > Credentials with these exact names) ---
TELEGRAM_BOT_CREDENTIAL_NAME=Finxxment Telegram Bot
GEMINI_API_CREDENTIAL_NAME=Finxxment Gemini API
GOOGLE_SHEETS_OAUTH_CREDENTIAL_NAME=Finxxment Google Sheets
GOOGLE_DRIVE_OAUTH_CREDENTIAL_NAME=Finxxment Google Drive

# --- Values to paste into each workflow's "Config" Set node ---
TELEGRAM_OWNER_CHAT_ID=<numeric chat id, whitelist - see docs/02-setup-guide.md step 4>
SPREADSHEET_ID=<Google Sheet ID from its URL>
DRIVE_PROOF_FOLDER_ID=<private Google Drive folder ID for proof photos>
APPS_SCRIPT_WEBAPP_URL=<deployed Apps Script Web App /exec URL>
APPS_SCRIPT_WEBAPP_SECRET=<random shared secret; must match SHARED_SECRET in apps-script/40-webhook-api.gs>

# --- Values used only inside Apps Script (Project Settings > Script Properties) ---
# Do not hardcode the secret in apps-script/40-webhook-api.gs; set it as a
# Script Property named SHARED_SECRET and read it via
# PropertiesService.getScriptProperties().getProperty('SHARED_SECRET').
