        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            }
          }
        }
      },
      "id": "ffa2e2e2-49fb-4916-ab87-f2623f5d95e8",
      "name": "Google Drive: Export XLSX",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        500,
        0
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "PLACEHOLDER",
          "name": "Finxxment Google Drive"
        }
      },
      "notes": "Google Drive's file-download endpoint with export mimeType converts the Sheet to .xlsx binary."
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Config\"].json.OWNER_CHAT_ID}}",
        "operation": "sendDocument",
        "binaryData": true,
        "additionalFields": {
          "caption": "📎 Export bulanan finxxment (.xlsx)"
        }
      },
      "id": "c3cd1741-ce5a-441c-bac8-386b1e28014d",
      "name": "Telegram: Send XLSX Document",
      "type": "n8n-nodes-base.telegram",
