    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst thisMonth = rows.filter(r => new Date(r['Tanggal Transaksi']).getMonth() === now.getMonth());\nconst lastMonthNum = now.getMonth() === 0 ? 11 : now.getMonth() - 1;\nconst lastMonth = rows.filter(r => new Date(r['Tanggal Transaksi']).getMonth() === lastMonthNum);\nfunction sum(list, jenis) { return list.filter(r => r.Jenis === jenis).reduce((s, r) => s + Number(r.Nominal || 0), 0); }\nconst byKategori = {};\nthisMonth.filter(r => r.Jenis === 'Keluar').forEach(r => { byKategori[r.Kategori] = (byKategori[r.Kategori] || 0) + Number(r.Nominal || 0); });\nconst topKategori = Object.entries(byKategori).sort((a,b) => b[1]-a[1]).slice(0,5).map(([kategori,total]) => ({kategori, total}));\nconst dayOfMonth = now.getDate();\nconst daysInMonth = new Date(now.getFullYear(), now.getMonth()+1, 0).getDate();\nconst totalKeluar = sum(thisMonth, 'Keluar');\nconst burnRateHarian = Math.round(totalKeluar / dayOfMonth);\nreturn [{ json: {\n  periode: 'bulanan',\n  total_masuk: sum(thisMonth, 'Masuk'),\n  total_keluar: totalKeluar,\n  total_masuk_periode_lalu: sum(lastMonth, 'Masuk'),\n  total_keluar_periode_lalu: sum(lastMonth, 'Keluar'),\n  top_kategori: topKategori,\n  burn_rate_harian: burnRateHarian,\n  proyeksi_akhir_bulan: burnRateHarian * daysInMonth\n}}];\n"
      },
