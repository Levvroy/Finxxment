    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Patches the pending payload's missing field(s) using the user's free-text reply.\n// Handles the common case: bot asked for a nominal, user replied with a bare number/shorthand.\nconst pending = $json.pendingRow;\nconst payload = JSON.parse(pending['Raw Payload'] || '{}');\nconst reply = $json.incomingText.trim().toLowerCase();\n\nfunction normalizeNominal(raw) {\n  const s = raw.replace(/[^0-9a-z.,]/g, '');\n  const m = s.match(/([0-9.,]+)(rb|ribu|k|jt|juta)?/);\n  if (!m) return null;\n  let num = parseFloat(m[1].replace(',', '.'));\n  if (m[2] === 'rb' || m[2] === 'ribu' || m[2] === 'k') num *= 1000;\n  if (m[2] === 'jt' || m[2] === 'juta') num *= 1000000;\n  return Math.round(num);\n}\n\nlet resolved = false;\nif (!payload.nominal) {\n  const n = normalizeNominal(reply);\n  if (n) { payload.nominal = n; resolved = true; }\n} else {\n  resolved = true; // other ambiguity (e.g. kategori) - treat any non-empty reply as the clarification\n  payload.catatan = (payload.catatan || '') + ' | klarifikasi: ' + reply;\n}\nif (resolved) payload.confidence = 'medium';\n\nreturn [{ json: { ...$json, payload, resolved } }];\n"
      },
      "id": "45f0db95-0f52-40f6-9cff-e7d56c29dcd4",
      "name": "Code: Interpret Low-Confidence Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        250
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const pending = $json.pendingRow;\nconst payload = JSON.parse(pending['Raw Payload'] || '{}');\nconst reply = $json.incomingText.trim().toLowerCase();\n\nlet resolved = true;\nif (reply === 'teks') {\n  // keep payload.nominal as-is (from text extraction)\n} else if (reply === 'bukti') {\n  payload.nominal = payload.vision ? payload.vision.nominal_dari_bukti : payload.nominal;\n} else {\n  const n = parseInt(reply.replace(/[^0-9]/g, ''), 10);\n  if (!isNaN(n) && n > 0) { payload.nominal = n; } else { resolved = false; }\n}\nif (resolved) payload.status = 'mismatch-resolved';\n\nreturn [{ json: { ...$json, payload, resolved } }];\n"
      },
      "id": "7cc0e96c-60bf-4178-9840-641838bb2c22",
      "name": "Code: Interpret Mismatch Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        400
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Expects 'field=value [field2=value2 ...]'\nconst pending = $json.pendingRow;\nconst payload = JSON.parse(pending['Raw Payload'] || '{}');\nconst reply = $json.incomingText.trim();\nconst fields = {};\nreply.split(/\\s+/).forEach(p => { const [k, v] = p.split('='); if (k && v) fields[k] = v; });\nconst resolved = Object.keys(fields).length > 0;\nreturn [{ json: { ...$json, payload, fields, resolved, id: payload.id } }];\n"
      },
      "id": "e628ad87-aa47-4aec-8137-5db913d50348",
