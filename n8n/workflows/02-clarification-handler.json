      "parameters": {
        "language": "javaScript",
        "jsCode": "const p = $json.payload;\nreturn [{ json: {\n  ID: (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random()),\n  'Timestamp Input': new Date().toISOString(),\n  'Tanggal Transaksi': p.tanggal || new Date().toISOString().slice(0,10),\n  Jenis: p.jenis === 'masuk' ? 'Masuk' : 'Keluar',\n  Nominal: p.nominal,\n  Kategori: p.kategori || 'Lain-lain',\n  'Sub-kategori': p.sub_kategori || '',\n  'Tujuan/Merchant': p.tujuan || '',\n  'Sumber Dana': p.sumber_dana || '',\n  'Nama Rekening/Wallet': p.nama_rekening || '',\n  Catatan: p.catatan || '',\n  'Bukti (link)': p.webViewLink || '',\n  'Status Verifikasi': p.status === 'mismatch-resolved' ? 'Mismatch-Resolved' : (p.hasPhoto ? 'Verified' : 'Unverified'),\n  'Confidence AI': p.confidence || 'medium',\n  'Sumber Input': p.hasPhoto ? 'Telegram Text+Foto' : 'Telegram Text'\n}}];\n"
      },
